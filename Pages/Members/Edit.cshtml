@page
@model Coman_Ionut_Alexandru_Lab2.Pages.MemberPages.EditModel

@{
    ViewData["Title"] = "Edit Member";
}

<h1>Edit Member</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="Member.ID" />

            <div class="form-group">
                <label asp-for="Member.FirstName"
                       class="control-label"></label>
                <input asp-for="Member.FirstName"
                       class="form-control" />
                <span asp-validation-for="Member.FirstName"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Member.LastName"
                       class="control-label"></label>
                <input asp-for="Member.LastName"
                       class="form-control" />
                <span asp-validation-for="Member.LastName"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Member.Adress"
                       class="control-label">Address</label>
                <input asp-for="Member.Adress"
                       class="form-control" />
                <span asp-validation-for="Member.Adress"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Member.Email"
                       class="control-label"></label>
                <input asp-for="Member.Email"
                       class="form-control" />
                <span asp-validation-for="Member.Email"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Member.Phone"
                       class="control-label"></label>
                <input asp-for="Member.Phone"
                       class="form-control" />
                <span asp-validation-for="Member.Phone"
                      class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}