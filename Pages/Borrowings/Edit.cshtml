@page
@model Coman_Ionut_Alexandru_Lab2.Pages.Borrowings.EditModel

@{
    ViewData["Title"] = "Edit Borrowing";
}

<h1>Edit Borrowing</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="Borrowing.ID" />

            <div class="form-group">
                <label asp-for="Borrowing.MemberID"
                       class="control-label">
                    Member
                </label>
                <select asp-for="Borrowing.MemberID"
                        class="form-control"
                        asp-items="ViewBag.MemberID">
                </select>
                <span asp-validation-for="Borrowing.MemberID"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Borrowing.BookID"
                       class="control-label">
                    Book
                </label>
                <select asp-for="Borrowing.BookID"
                        class="form-control"
                        asp-items="ViewBag.BookID">
                </select>
                <span asp-validation-for="Borrowing.BookID"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Borrowing.ReturnDate"
                       class="control-label">
                    Return Date
                </label>
                <input asp-for="Borrowing.ReturnDate"
                       class="form-control" />
                <span asp-validation-for="Borrowing.ReturnDate"
                      class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}